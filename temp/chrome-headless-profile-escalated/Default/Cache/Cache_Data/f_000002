<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DermAI CDSS — Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet" />
    <style>
        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #0a0f1e;
            --card: #111827;
            --border: #1e2d45;
            --accent: #3b82f6;
            --accent2: #6366f1;
            --success: #10b981;
            --danger: #ef4444;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --input-bg: #0d1526;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Animated blobs */
        .blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.18;
            animation: drift 14s ease-in-out infinite alternate;
            pointer-events: none;
        }

        .blob-1 {
            width: 520px;
            height: 520px;
            background: #3b82f6;
            top: -120px;
            left: -120px;
            animation-delay: 0s;
        }

        .blob-2 {
            width: 420px;
            height: 420px;
            background: #6366f1;
            bottom: -100px;
            right: -80px;
            animation-delay: -5s;
        }

        .blob-3 {
            width: 300px;
            height: 300px;
            background: #06b6d4;
            top: 40%;
            left: 50%;
            animation-delay: -9s;
        }

        @keyframes drift {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(30px, 40px) scale(1.08);
            }
        }

        /* Card */
        .card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 460px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 40px 40px 36px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(59, 130, 246, 0.08);
            animation: slideUp .45s cubic-bezier(.22, 1, .36, 1) both;
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(28px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Logo / header */
        .logo-area {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 60px;
            height: 60px;
            border-radius: 16px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            font-size: 28px;
            margin-bottom: 14px;
            box-shadow: 0 8px 24px rgba(99, 102, 241, 0.4);
        }

        .logo-area h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            letter-spacing: -0.3px;
        }

        .logo-area p {
            font-size: 13px;
            color: var(--muted);
            margin-top: 4px;
        }

        /* Tabs */
        .tabs {
            display: flex;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 4px;
            margin-bottom: 28px;
        }

        .tab-btn {
            flex: 1;
            padding: 9px 0;
            border: none;
            background: transparent;
            color: var(--muted);
            font-size: 13.5px;
            font-weight: 500;
            cursor: pointer;
            border-radius: 7px;
            transition: all .2s;
            font-family: 'Inter', sans-serif;
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            color: #fff;
            box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
        }

        /* Form panels */
        .panel {
            display: none;
        }

        .panel.active {
            display: block;
        }

        /* Labels & inputs */
        .field {
            margin-bottom: 16px;
        }

        .field label {
            display: block;
            font-size: 12.5px;
            font-weight: 500;
            color: var(--muted);
            margin-bottom: 6px;
            letter-spacing: 0.3px;
        }

        .field input {
            width: 100%;
            padding: 11px 14px;
            background: var(--input-bg);
            border: 1px solid var(--border);
            border-radius: 9px;
            color: var(--text);
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            transition: border-color .2s, box-shadow .2s;
            outline: none;
        }

        .field input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
        }

        .field input::placeholder {
            color: #3d5070;
        }

        /* Two-column row */
        .row-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        /* Submit button */
        .btn-submit {
            width: 100%;
            padding: 13px;
            margin-top: 6px;
            border: none;
            border-radius: 10px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            color: #fff;
            font-size: 15px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            letter-spacing: 0.2px;
            transition: opacity .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 6px 20px rgba(99, 102, 241, 0.4);
        }

        .btn-submit:hover {
            opacity: .92;
            transform: translateY(-1px);
            box-shadow: 0 10px 28px rgba(99, 102, 241, 0.5);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .btn-submit:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
        }

        /* Alert messages */
        .alert {
            display: none;
            padding: 11px 14px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 16px;
            line-height: 1.45;
        }

        .alert.error {
            background: rgba(239, 68, 68, .12);
            border: 1px solid rgba(239, 68, 68, .35);
            color: #fca5a5;
            display: block;
        }

        .alert.success {
            background: rgba(16, 185, 129, .12);
            border: 1px solid rgba(16, 185, 129, .35);
            color: #6ee7b7;
            display: block;
        }

        /* Spinner */
        .spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(255, 255, 255, .3);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
            vertical-align: middle;
            margin-right: 6px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 20px 0 16px;
        }

        .switch-hint {
            text-align: center;
            font-size: 12.5px;
            color: var(--muted);
            margin-top: 18px;
        }

        .switch-hint a {
            color: var(--accent);
            cursor: pointer;
            text-decoration: none;
            font-weight: 500;
        }

        .switch-hint a:hover {
            text-decoration: underline;
        }

        /* Optional badge */
        .opt-badge {
            font-size: 10px;
            background: rgba(148, 163, 184, 0.12);
            color: var(--muted);
            border-radius: 4px;
            padding: 1px 5px;
            margin-left: 5px;
            vertical-align: middle;
            letter-spacing: 0.3px;
        }

        /* Bottom footer */
        .footer {
            text-align: center;
            margin-top: 22px;
            font-size: 11.5px;
            color: #2d4060;
        }
    </style>
</head>

<body>

    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <div class="card">

        <!-- Logo -->
        <div class="logo-area">
            <div class="logo-icon">🧬</div>
            <h1>DermAI CDSS</h1>
            <p>AI-Powered Dermatology Clinical Decision Support</p>
        </div>

        <!-- Tabs -->
        <div class="tabs">
            <button class="tab-btn active" id="tab-login" onclick="switchTab('login')">Login</button>
            <button class="tab-btn" id="tab-signup" onclick="switchTab('signup')">Sign Up</button>
        </div>

        <!-- ===== LOGIN PANEL ===== -->
        <div class="panel active" id="panel-login">
            <div class="alert" id="login-alert"></div>

            <div class="field">
                <label>Email Address</label>
                <input type="email" id="login-email" placeholder="doctor@hospital.com" autocomplete="email" />
            </div>

            <div class="field">
                <label>Password</label>
                <input type="password" id="login-password" placeholder="Enter your password"
                    autocomplete="current-password" />
            </div>

            <button class="btn-submit" id="login-btn" onclick="doLogin()">Login</button>

            <p class="switch-hint">
                No account yet? <a onclick="switchTab('signup')">Create one →</a>
            </p>
        </div>

        <!-- ===== SIGNUP PANEL ===== -->
        <div class="panel" id="panel-signup">
            <div class="alert" id="signup-alert"></div>

            <div class="field">
                <label>Full Name</label>
                <input type="text" id="su-name" placeholder="Dr. Your Name" autocomplete="name" />
            </div>

            <div class="field">
                <label>Email Address</label>
                <input type="email" id="su-email" placeholder="doctor@hospital.com" autocomplete="email" />
            </div>

            <div class="field">
                <label>Password</label>
                <input type="password" id="su-password" placeholder="Choose a password" autocomplete="new-password" />
            </div>

            <hr class="divider" />

            <div class="row-2">
                <div class="field">
                    <label>License No. <span class="opt-badge">optional</span></label>
                    <input type="text" id="su-license" placeholder="LIC-12345" />
                </div>
                <div class="field">
                    <label>Clinic Name <span class="opt-badge">optional</span></label>
                    <input type="text" id="su-clinic" placeholder="City Derm Clinic" />
                </div>
            </div>

            <button class="btn-submit" id="signup-btn" onclick="doSignup()">Create Account</button>

            <p class="switch-hint">
                Already have an account? <a onclick="switchTab('login')">Login →</a>
            </p>
        </div>

        <p class="footer">© 2025 DermAI CDSS &nbsp;·&nbsp; For authorized medical personnel only</p>
    </div>

    <script>
        // ── Redirect if already logged in ──────────────────────────────
        if (sessionStorage.getItem('doctor_id')) {
            window.location.href = '/';
        }

        // ── Tab switcher ───────────────────────────────────────────────
        function switchTab(tab) {
            ['login', 'signup'].forEach(t => {
                document.getElementById('panel-' + t).classList.toggle('active', t === tab);
                document.getElementById('tab-' + t).classList.toggle('active', t === tab);
            });
            clearAlerts();
        }

        function clearAlerts() {
            ['login-alert', 'signup-alert'].forEach(id => {
                const el = document.getElementById(id);
                el.className = 'alert';
                el.textContent = '';
            });
        }

        function showAlert(id, msg, type) {
            const el = document.getElementById(id);
            el.className = 'alert ' + type;
            el.textContent = msg;
        }

        function setLoading(btnId, loading, label) {
            const btn = document.getElementById(btnId);
            btn.disabled = loading;
            btn.innerHTML = loading
                ? `<span class="spinner"></span> Please wait…`
                : label;
        }

        // ── Login ──────────────────────────────────────────────────────
        async function doLogin() {
            const email = document.getElementById('login-email').value.trim();
            const password = document.getElementById('login-password').value;

            if (!email || !password) {
                showAlert('login-alert', 'Please enter your email and password.', 'error');
                return;
            }

            setLoading('login-btn', true, 'Login');
            clearAlerts();

            try {
                const res = await fetch('/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email, password })
                });
                const data = await res.json();

                if (data.success) {
                    sessionStorage.setItem('doctor_id', data.doctor_id);
                    sessionStorage.setItem('doctor_name', data.name);
                    showAlert('login-alert', `Welcome back, ${data.name}! Redirecting…`, 'success');
                    setTimeout(() => { window.location.href = '/'; }, 800);
                } else {
                    showAlert('login-alert', data.error || 'Login failed. Please try again.', 'error');
                    setLoading('login-btn', false, 'Login');
                }
            } catch (err) {
                showAlert('login-alert', 'Cannot reach server. Is the backend running?', 'error');
                setLoading('login-btn', false, 'Login');
            }
        }

        // ── Signup ─────────────────────────────────────────────────────
        async function doSignup() {
            const name = document.getElementById('su-name').value.trim();
            const email = document.getElementById('su-email').value.trim();
            const password = document.getElementById('su-password').value;
            const license = document.getElementById('su-license').value.trim();
            const clinic = document.getElementById('su-clinic').value.trim();

            if (!name || !email || !password) {
                showAlert('signup-alert', 'Name, email, and password are required.', 'error');
                return;
            }
            if (password.length < 4) {
                showAlert('signup-alert', 'Password must be at least 4 characters.', 'error');
                return;
            }

            setLoading('signup-btn', true, 'Create Account');
            clearAlerts();

            try {
                const res = await fetch('/signup', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        name, email, password,
                        license_number: license,
                        clinic_name: clinic
                    })
                });
                const data = await res.json();

                if (data.success) {
                    sessionStorage.setItem('doctor_id', data.doctor_id);
                    sessionStorage.setItem('doctor_name', data.name);
                    showAlert('signup-alert', `Account created! Welcome, ${data.name}. Redirecting…`, 'success');
                    setTimeout(() => { window.location.href = '/'; }, 900);
                } else {
                    showAlert('signup-alert', data.error || 'Signup failed. Please try again.', 'error');
                    setLoading('signup-btn', false, 'Create Account');
                }
            } catch (err) {
                showAlert('signup-alert', 'Cannot reach server. Is the backend running?', 'error');
                setLoading('signup-btn', false, 'Create Account');
            }
        }

        // ── Enter key triggers submit ──────────────────────────────────
        document.addEventListener('keydown', e => {
            if (e.key !== 'Enter') return;
            const loginActive = document.getElementById('panel-login').classList.contains('active');
            if (loginActive) doLogin();
            else doSignup();
        });
    </script>
</body>

</html>